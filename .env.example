# Copia questo file in .env.local e compila i valori.
# Nessuna di queste variabili e' obbligatoria per avviare il sito in modalita' WhatsApp.

# URL pubblico del sito (senza slash finale). Abilita canonical, sitemap e Open Graph assoluti.
NEXT_PUBLIC_SITE_URL=

# Canale di consegna delle richieste: "whatsapp" (predefinito) oppure "telegram".
NEXT_PUBLIC_BOOKING_DELIVERY=whatsapp

# --- Solo per la consegna automatica via Telegram (lato server, MAI con prefisso NEXT_PUBLIC_) ---
# Token del bot ottenuto da @BotFather.
TELEGRAM_BOT_TOKEN=
# ID della chat privata del titolare che ricevera' le richieste.
TELEGRAM_CHAT_ID=
